// GENERATED from wrangler.template.jsonc by tooling/wire — edit the
// template, not this file. The committed copy is the fixture render
// (`pnpm run wire:fixture`); every Orun lane renders its own environment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-explorer-web",
  // R2-Explorer, configured from the Worker's secrets (src/config.ts). wrangler
  // bundles it; there is no build of its own.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The dashboard: the package's prebuilt single-page app, copied here by the
  // build (scripts/build-dashboard.mjs). Upstream's asset settings, unchanged:
  // a path without a file is the app's, and the Worker answers /api/*.
  "assets": {
    "directory": "dist/dashboard",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The bucket the explorer manages. Its binding name is what the dashboard
  // shows as the bucket's name, as upstream's is.
  "r2_buckets": [
    {
      "binding": "bucket",
      "bucket_name": "stg-r2-explorer-stage"
    }
  ]
}
